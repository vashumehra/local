        <p>FB ad campaign entry form</p>
      </div>
      <div class="module-card" onclick="switchForm('call', null)">
        <h5>Call Leads</h5>
        <p>Inbound & outbound call records</p>
      </div>
      <div class="module-card" onclick="switchForm('justdial', null)">
        <h5>Just Dial Leads</h5>
        <p>Vendor & inquiry listing update</p>
      </div>
      <div class="module-card" onclick="switchForm('properties', null)">
        <h5>Properties Details</h5>
        <p>Real estate & asset registry</p>
      </div>
      <div class="module-card" onclick="switchForm('vendors', null)">
        <h5>Vendor Entries</h5>
        <p>Merchant onboarding records</p>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Edwin Incorporation</h4>
        <p>A global platform offering Research Publication Services, DOI/ISSN guidance, and patent support with academic consultancy worldwide.</p>
      </div>
      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="#">About Us</a></li>
          <li><a href="#">Apply for Jobs</a></li>
          <li><a href="#">Partnership Programme</a></li>
          <li><a href="#">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Our Services</h4>
        <ul>
          <li><a href="#">Research Paper Publishing</a></li>
          <li><a href="#">R&D / EBI Support</a></li>
          <li><a href="#">University & College Ties</a></li>
          <li><a href="#">Edwin Journal Network</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact Us</h4>
        <p>40-41, Lower Ground Floor (LGF) Bakshi House, Nehru Place, New Delhi, Delhi 110019</p>
        <p>Email: care@edwinepc.com</p>
        <p>Phone: +91 6262752168</p>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; 2026 Edwin Incorporation. All Rights Reserved.
    </div>
  </footer>

  <!-- Script for Switching Forms -->
  <script>
    // Form URLs Map (Apne real zoho form links yahan dal sakte hain)
    const formsDatabase = {
      academic: { title: "Academician DEO Form", url: "https://forms.zohopublic.com" },
      ngo: { title: "NGO Lead Entry Form", url: "https://forms.zohopublic.com" },
      city: { title: "Local City Lead Form", url: "https://forms.zohopublic.com" },
      business: { title: "Business DEO Form", url: "https://forms.zohopublic.com" },
      university: { title: "University Lead Form", url: "https://forms.zohopublic.com" },
      editor: { title: "Journal Editor Data Form", url: "https://forms.zohopublic.com" },
      phd: { title: "PhD Student Services Form", url: "https://forms.zohopublic.com" },
      admission: { title: "Admission Lead Entry Form", url: "https://forms.zohopublic.com" },
      gem: { title: "GEM Bid & Tender Entry", url: "https://forms.zohopublic.com" },
      facebook: { title: "Facebook Ad Leads Module", url: "https://forms.zohopublic.com" },
      call: { title: "Call Center Inbound Leads", url: "https://forms.zohopublic.com" },
      justdial: { title: "JustDial Inquiries Register", url: "https://forms.zohopublic.com" },
      properties: { title: "Properties Portfolio Management", url: "https://forms.zohopublic.com" },
      vendors: { title: "Vendor Onboarding Portal", url: "https://forms.zohopublic.com" }
    };

    function switchForm(key, element) {
      if (!formsDatabase[key]) return;

      // Update Active Tab Class
      if (element) {
        document.querySelectorAll('.tab-item').forEach(tab => tab.classList.remove('active'));
        element.classList.add('active');
      }

      // Update Form Heading and Frame Link
      document.getElementById('current-form-name').innerText = formsDatabase[key].title;
      document.getElementById('deo-iframe').src = formsDatabase[key].url;
      
      // Smooth scroll back to form viewport if card clicked
      if (!element) {
        document.querySelector('.crm-section').scrollIntoView({ behavior: 'smooth' });
      }
    }
  </script>
</body>
</html>
