    <div>Edwin Incorporation | Academic Services</div>
  </div>

  <!-- Header -->
  <header>
    <div class="nav-container">
      <div class="logo-area">
        <h1>Edwin Incorporation</h1>
        <span>Services for Academicians || Universities || Colleges || Journals</span>
      </div>
      <ul class="main-nav">
        <li><a href="#">Home</a></li>
        <li><a href="#">Academicians</a></li>
        <li><a href="#">R&D/EBI</a></li>
        <li><a href="#">Educational</a></li>
        <li><a href="#">University/College</a></li>
        <li><a href="#">Pay Now</a></li>
        <li><a href="#">Contact</a></li>
      </ul>
    </div>
  </header>

  <!-- Banner / Summary -->
  <section class="hero">
    <h2>Edwin Incorporation CRM - Data Entry Work</h2>
    <p>Facebook Data Leads, Conference Data Leads, Journals Data Leads, and multiple CRM based service forms in one unified dashboard.</p>
    
    <div class="metrics">
      <div class="badge">
        <strong>14+</strong>
        <span>CRM Forms</span>
      </div>
      <div class="badge">
        <strong>8</strong>
        <span>Main Services</span>
      </div>
      <div class="badge">
        <strong>6</strong>
        <span>Quick Modules</span>
      </div>
      <div class="badge">
        <strong>Live</strong>
        <span>Zoho Forms</span>
      </div>
    </div>
  </section>

  <!-- Main Functional Layout -->
  <main class="wrapper">
    <div class="tabs-header">
      <h3>Select Service Module</h3>
      <div class="tab-list">
        <button class="tab-item active" onclick="switchForm('academic', this)">Academicians Serv</button>
        <button class="tab-item" onclick="switchForm('ngo', this)">NGO Serv</button>
        <button class="tab-item" onclick="switchForm('city', this)">Local City Ser</button>
        <button class="tab-item" onclick="switchForm('business', this)">Business Ser</button>
        <button class="tab-item" onclick="switchForm('university', this)">University Serv</button>
        <button class="tab-item" onclick="switchForm('editor', this)">Editor Serv</button>
        <button class="tab-item" onclick="switchForm('phd', this)">PhD Student Serv</button>
        <button class="tab-item" onclick="switchForm('admission', this)">Admission Student Serv</button>
