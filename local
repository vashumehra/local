    </section>

    <!-- Quick Shortcuts Grid -->
    <div class="module-grid">
      <div class="module-card" onclick="switchForm('gem', null)">
        <h5>GEM Entries</h5>
        <p>GEM bids and supplier data entry</p>
      </div>
      <div class="module-card" onclick="switchForm('facebook', null)">
