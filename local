    </div>

    <!-- Active Form Viewport -->
    <section class="crm-section">
      <div class="crm-header">
        <h4 id="current-form-name">Academician DEO Form</h4>
        <span style="font-size: 13px; color: var(--text-muted);">Connected via Secure Zoho Portal</span>
      </div>
      
      <div class="frame-box">
        <!-- Default Embedded Zoho Form Frame -->
        <iframe id="deo-iframe" src="https://forms.zohopublic.com" title="Lead Entry Window"></iframe>
